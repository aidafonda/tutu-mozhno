# Публичный remote MCP Туту. Авторизация не требуется.
TUTU_MCP_URL=https://mcp.tutu.ru/mcp

# demo — при недоступности MCP показать явно подписанные демонстрационные карточки.
# off — вернуть ошибку и никогда не показывать fallback.
FALLBACK_MODE=demo

# Домен, направленный A-записью на VPS. Caddy автоматически выпустит HTTPS.
APP_DOMAIN=localhost
